PORT=10000
NODE_ENV=development
APP_URL=http://localhost:10000
AUTH_PUBLIC_URL=https://ecosystem-auth-service.onrender.com
OAUTH_CLIENT_ID=nexora
# Same value as NEXORA_CLIENT_SECRET in ecosystem-auth-service (>= 32 chars)
OAUTH_CLIENT_SECRET=replace_with_same_secret_as_auth_service
SESSION_SECRET=replace_with_random_secret_at_least_32_chars
# Same value as NEXORA_SERVICE_API_KEY in ecosystem-auth-service (>= 32 chars); needed for usage accounting
AUTH_SERVICE_API_KEY=
AUTH_SERVICE_CLIENT_ID=nexora
IMAGE_STUDIO_URL=https://nexora-image-studio.onrender.com
PROJECT_GENERATOR_URL=https://vse-proekty-ian-1.onrender.com
# Argosha chat providers (at least one)
OPENROUTER_API_KEY=
GROQ_API_KEY=

NEXORA_LOBBY_URL=https://nexora-lobby.onrender.com
NEXORA_PUBLIC_LOBBY_URL=https://nexora-lobby-yan12312.msk1.amvera.tech
MATH_STUDIO_URL=https://nexora-math-studio.onrender.com
TEXT_STUDIO_URL=https://nexora-text-studio.onrender.com
NEXORA_ALLOW_PRODUCTION_SMOKE=0
